<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Planet Icon -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🪐"
            android:textSize="48sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLANET QUIZ"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:layout_marginTop="8dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test your knowledge of the Solar System"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Progress -->
        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUESTION 1 OF 3"
            android:textColor="@color/primary_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:max="3"
            android:progress="1"
            android:progressTint="@color/primary_purple"
            android:layout_marginBottom="24dp" />

        <!-- Question Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/quiz_card"
            android:padding="24dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUESTION"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is the largest planet?"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Answer Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHOOSE YOUR ANSWER"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Planet Buttons -->

        <Button
            android:id="@+id/mercuryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="MERCURY"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/venusButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VENUS"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/earthButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="EARTH"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/marsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="MARS"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/jupiterButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="JUPITER"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/saturnButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SATURN"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/uranusButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="URANUS"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/neptuneButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="NEPTUNE"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/planet_button"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>