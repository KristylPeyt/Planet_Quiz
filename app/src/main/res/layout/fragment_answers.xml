<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Planet -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🪐"
            android:textSize="52sp"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <!-- Result -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correct!"
            android:textColor="@color/correct_green"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Small message -->
        <TextView
            android:id="@+id/resultSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Great job! You got it right."
            android:textColor="@color/text_light"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- Answer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/quiz_card"
            android:padding="24dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR ANSWER"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/questionAnswerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is the largest planet?"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- Explanation Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DID YOU KNOW?"
            android:textColor="@color/primary_purple"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <!-- Explanation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/quiz_card"
            android:padding="24dp"
            android:layout_marginBottom="30dp">

            <TextView
                android:id="@+id/explanationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jupiter is the largest planet..."
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

        <!-- Next Button -->
        <Button
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="NEXT QUESTION"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/next_button"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>